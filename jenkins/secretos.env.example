# Copiar este archivo a jenkins/secretos.env y completarlo. secretos.env NO se sube a git.

# Contrasena del usuario admin de Jenkins
JENKINS_ADMIN_PASSWORD=

# Docker Hub: usuario y access token con permiso Read & Write
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# Token de API de Snyk (app.snyk.io > Account settings > Auth Token)
SNYK_TOKEN=

# Repositorio de la imagen en Docker Hub (usuario/nombre)
DOCKER_IMAGE_REPO=

# Repositorio y rama que clona el pipeline
GIT_REPO_URL=https://github.com/Andychristoff/blue-green-ejercicio-DevOps.git
GIT_BRANCH=main
